# ==============================================================================
# AI Provider Configuration (Current: OmniRoute | Future: OpenAI | Local: Ollama)
# ==============================================================================
# Choose active AI provider: "omniroute" | "openai" | "ollama" | "auto"
AI_PROVIDER=omniroute

# ------------------------------------------------------------------------------
# 1. OmniRoute API Configuration (Currently Active)
# ------------------------------------------------------------------------------
# Get your API key from OmniRoute Dashboard: https://omniroute.ai
OMNIROUTE_API_KEY=your-omniroute-api-key-here
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. OpenAI Configuration (Future Upgrade)
# ------------------------------------------------------------------------------
# Get your API key from OpenAI Platform: https://platform.openai.com
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. Local Ollama LLM Configuration (Private / Offline Fallback)
# ------------------------------------------------------------------------------
# Base URL for local Ollama instance (default: http://localhost:11434)
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Get these from your Supabase project dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / publishable)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# You can use either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key-here

# Optional: Supabase Service Role Key (for administrative tasks / backend scripts)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# Application URL
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
